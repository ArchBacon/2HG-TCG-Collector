# Local development. Used by `flutter run` via the IDE run configuration.
# Override values for your machine in env/dev.local.env (git-ignored), e.g. your LAN IP for a physical phone.
APP_ENV=dev
# localhost is rewritten to 10.0.2.2 on Android, so this works on both the Android emulator and iOS simulator.
API_BASE_URL=http://localhost:8000
