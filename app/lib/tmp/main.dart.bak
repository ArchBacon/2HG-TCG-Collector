import 'package:app/tmp/core/config/env.dart';
import 'package:app/tmp/core/identity/token.dart';
import 'package:app/tmp/features/home/screens/home.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';



Future<void> main() async {
  Env.validate();
  WidgetsFlutterBinding.ensureInitialized();

  // Only allow portrait mode
  await SystemChrome.setPreferredOrientations([DeviceOrientation.portraitUp]);

  // Ensure the anonymous identity exists, before the app runs.
  await loadOrCreateToken();

  // Start app
  runApp(ProviderScope(child: MaterialApp(
    theme: ThemeData(
      fontFamily: 'Inter',
      colorScheme: ColorScheme.fromSeed(
        seedColor: const Color(0xFF5CB85C),
        brightness: Brightness.dark,
        surface: const Color(0xFF10141A),
      ),
      scaffoldBackgroundColor: const Color(0xFF10141A),
    ),
    // Keeps content clear of the system navigation bar and screen cutouts on every screen. The top
    // is left out: app bars already pad for the status bar, and the glass app bar extends behind it.
    // The ColoredBox fills the inset areas with the page background instead of leaving them black.
    builder: (context, child) => ColoredBox(
      color: const Color(0xFF10141A),
      child: SafeArea(top: false, child: child!),
    ),
    home: Column(),
  )));
}
