{% extends 'base.html.twig' %}

{% block title %}Search — TCG Collector{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/style.css') }}">
{% endblock %}

{% block body %}
    <header class="search-header">
        <a href="{{ path('app_home') }}" class="logo">TCG Collector</a>
        <form class="search-form" id="search-form">
            <select name="game" id="game" required></select>
            <input type="text" name="q" id="q" placeholder="Card name…" autocomplete="off" required>
            <button type="submit">Search</button>
        </form>
    </header>
    <main>
        <p id="status"></p>
        <div id="results" class="results-grid"></div>
        <div id="pagination" class="pagination" hidden>
            <button type="button" id="prev-page">&laquo; Prev</button>
            <span id="page-info"></span>
            <button type="button" id="next-page">Next &raquo;</button>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/app.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const select = document.getElementById('game');
            const input = document.getElementById('q');
            const form = document.getElementById('search-form');
            const status = document.getElementById('status');
            const results = document.getElementById('results');
            const pagination = document.getElementById('pagination');
            const prevButton = document.getElementById('prev-page');
            const nextButton = document.getElementById('next-page');
            const pageInfo = document.getElementById('page-info');

            const params = new URLSearchParams(location.search);
            const initialGame = params.get('game') || GAMES[0].code;
            const initialQuery = params.get('q') || '';
            const initialPage = Math.max(1, parseInt(params.get('page'), 10) || 1);

            populateGameSelect(select, initialGame);
            input.value = initialQuery;

            let currentPage = initialPage;
            let totalPages = 1;

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                navigate(select.value, input.value.trim(), 1);
            });

            prevButton.addEventListener('click', () => {
                if (currentPage > 1) {
                    navigate(select.value, input.value.trim(), currentPage - 1);
                }
            });

            nextButton.addEventListener('click', () => {
                if (currentPage < totalPages) {
                    navigate(select.value, input.value.trim(), currentPage + 1);
                }
            });

            function navigate(game, q, page) {
                const url = new URL(location.href);
                url.searchParams.set('game', game);
                url.searchParams.set('q', q);
                url.searchParams.set('page', String(page));
                history.pushState({}, '', url);
                runSearch(game, q, page);
            }

            async function runSearch(game, q, page) {
                results.innerHTML = '';
                pagination.hidden = true;
                if (!q) {
                    status.textContent = '';
                    return;
                }

                status.textContent = 'Searching…';
                try {
                    const response = await fetch(`/api/${game}/cards.jsonld?name=${encodeURIComponent(q)}&page=${page}`, {
                        headers: { Accept: 'application/ld+json' },
                    });
                    if (!response.ok) {
                        throw new Error(`Request failed (${response.status})`);
                    }

                    const data = await response.json();
                    const cards = data.member || [];

                    if (cards.length === 0) {
                        status.textContent = page > 1 ? `No more results.` : `No cards found for "${q}".`;
                        return;
                    }

                    currentPage = page;
                    const lastPageMatch = data.view?.last?.match(/page=(\d+)/);
                    totalPages = lastPageMatch ? parseInt(lastPageMatch[1], 10) : 1;

                    status.textContent = `${data.totalItems} card(s) found.`;

                    for (const card of cards) {
                        const el = document.createElement('div');
                        el.className = 'card';

                        const img = document.createElement('img');
                        img.src = card.images?.medium ?? card.images?.small ?? '';
                        img.alt = card.name;
                        img.loading = 'lazy';

                        const name = document.createElement('div');
                        name.className = 'card-name';
                        name.textContent = card.name;

                        el.appendChild(img);
                        el.appendChild(name);
                        results.appendChild(el);
                    }

                    if (totalPages > 1) {
                        pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
                        prevButton.disabled = currentPage <= 1;
                        nextButton.disabled = currentPage >= totalPages;
                        pagination.hidden = false;
                    }
                } catch (err) {
                    status.textContent = `Error: ${err.message}`;
                }
            }

            if (initialQuery) {
                runSearch(initialGame, initialQuery, initialPage);
            }
        });
    </script>
{% endblock %}
