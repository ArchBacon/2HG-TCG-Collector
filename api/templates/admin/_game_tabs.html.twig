{# Expects: route, games (Game[]), current (string|null), allLabel (optional; adds an "all games" pill) #}
<div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
    {% if allLabel is defined %}
        <a href="{{ path(route) }}"
           class="shrink-0 rounded-full px-3 py-1.5 text-sm font-medium transition {{ current is empty ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' }}">{{ allLabel }}</a>
    {% endif %}
    {% for g in games %}
        <a href="{{ path(route, { game: g.value }) }}"
           class="shrink-0 rounded-full px-3 py-1.5 text-sm font-medium transition {{ g.value == current ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' }}">{{ g.value }}</a>
    {% endfor %}
</div>
