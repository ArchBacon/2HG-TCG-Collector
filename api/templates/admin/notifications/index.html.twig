{% extends 'admin/base.html.twig' %}

{% block title %}Notifications · TCG Admin{% endblock %}

{% block content %}
    <div class="mb-5">
        <h1 class="text-2xl font-semibold tracking-tight">Notifications</h1>
        <p class="mt-1 text-sm text-slate-500">Send a notification to the app: to everyone, or only to collectors of some games. Now, or at a set time. People can turn these off with "News and events" in the app's settings.</p>
    </div>

    {% if not configured %}
        <p class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">Firebase is not set up on this server (FIREBASE_CREDENTIALS), so nothing can be sent. You can still schedule.</p>
    {% endif %}

    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        {{ include('admin/notifications/_form.html.twig', {
            action: path('admin_notifications_create'),
            token: csrf_token('admin-notification'),
            submitLabel: 'Schedule',
            announcement: null,
        }) }}
    </section>

    {% if scheduled is not empty %}
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Scheduled</h2>
        <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <ul class="divide-y divide-slate-100">
                {% for item in scheduled %}
                    {% set a = item.announcement %}
                    <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-4 sm:px-5">
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-slate-900">{{ a.title }}</p>
                            <p class="truncate text-sm text-slate-500">{{ a.body }}</p>
                            <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                                <span class="inline-flex items-center gap-1">{{ ux_icon('lucide:calendar-clock', { class: 'h-3.5 w-3.5' }) }} {{ a.sendAt|date('j M Y H:i') }}</span>
                                <span>{{ include('admin/notifications/_audience.html.twig', { announcement: a }) }}</span>
                                <span>about {{ item.audience.devices }} {{ item.audience.devices == 1 ? 'device' : 'devices' }} now</span>
                            </p>
                        </div>
                        <div class="flex shrink-0 gap-1">
                            <a href="{{ path('admin_notifications_edit', { id: a.id }) }}"
                               class="inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                                {{ ux_icon('lucide:pencil', { class: 'h-4 w-4' }) }}
                                Edit
                            </a>
                            <form method="post" action="{{ path('admin_notifications_cancel', { id: a.id }) }}"
                                  onsubmit="return confirm('Cancel this notification? It won\'t be sent.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin-notification-cancel-' ~ a.id) }}">
                                <button type="submit"
                                        class="inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm text-slate-500 transition hover:bg-red-50 hover:text-red-700">
                                    {{ ux_icon('lucide:x', { class: 'h-4 w-4' }) }}
                                    Cancel
                                </button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Sent</h2>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        {% if past is empty %}
            <p class="px-4 py-10 text-center text-sm text-slate-500">Nothing sent yet.</p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for a in past %}
                    <li class="flex items-start gap-3 px-4 py-3 sm:px-5">
                        {% if a.status == 'sent' %}
                            {{ ux_icon('lucide:circle-check', { class: 'mt-0.5 h-4 w-4 shrink-0 text-emerald-600', title: 'Sent' }) }}
                        {% elseif a.status == 'sending' %}
                            {{ ux_icon('lucide:loader-circle', { class: 'mt-0.5 h-4 w-4 shrink-0 animate-spin text-sky-600', title: 'Sending' }) }}
                        {% elseif a.status == 'failed' %}
                            {{ ux_icon('lucide:circle-alert', { class: 'mt-0.5 h-4 w-4 shrink-0 text-red-600', title: 'Failed' }) }}
                        {% else %}
                            {{ ux_icon('lucide:circle-x', { class: 'mt-0.5 h-4 w-4 shrink-0 text-slate-400', title: 'Cancelled' }) }}
                        {% endif %}
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium {{ a.status == 'cancelled' ? 'text-slate-400 line-through' : 'text-slate-900' }}">{{ a.title }}</p>
                            <p class="truncate text-sm text-slate-500">{{ a.body }}</p>
                            <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                                <span>{{ (a.sentAt ?? a.sendAt)|date('j M Y H:i') }}</span>
                                <span>{{ include('admin/notifications/_audience.html.twig', { announcement: a }) }}</span>
                                {% if a.status == 'sent' %}
                                    <span>{{ a.devices }} {{ a.devices == 1 ? 'device' : 'devices' }}{{ a.failures ? ', ' ~ a.failures ~ ' failed' }}</span>
                                {% elseif a.status == 'sending' %}
                                    <span>Sending…</span>
                                {% elseif a.status == 'cancelled' %}
                                    <span>Cancelled</span>
                                {% endif %}
                                <span class="text-slate-400">by {{ a.createdBy }}</span>
                            </p>
                            {% if a.error %}
                                <p class="mt-1 break-words text-xs text-red-700">{{ a.error }}</p>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
