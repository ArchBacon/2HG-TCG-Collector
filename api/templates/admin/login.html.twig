{% extends 'base.html.twig' %}

{% block title %}Admin login · TCG Collector{% endblock %}

{% block body %}
    <main class="flex min-h-full items-center justify-center bg-slate-100 px-4 py-12">
        <div class="w-full max-w-sm">
            <div class="mb-6 flex flex-col items-center gap-2 text-center">
                {{ ux_icon('lucide:layers', { class: 'h-9 w-9 text-slate-400' }) }}
                <h1 class="text-2xl font-semibold tracking-tight text-slate-900">TCG Admin</h1>
                <p class="text-sm text-slate-500">Sign in to manage products and card images.</p>
            </div>

            <form method="post" action="{{ path('admin_login') }}" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                {% if error %}
                    <div class="flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                        {{ ux_icon('lucide:circle-alert', { class: 'mt-0.5 h-4 w-4 shrink-0' }) }}
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <label class="block text-sm">
                    <span class="font-medium text-slate-700">Username</span>
                    <input type="text" name="_username" value="{{ lastUsername }}" required autofocus autocomplete="username" autocapitalize="none"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base shadow-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200 sm:text-sm">
                </label>

                <label class="block text-sm">
                    <span class="font-medium text-slate-700">Password</span>
                    <input type="password" name="_password" required autocomplete="current-password"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base shadow-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200 sm:text-sm">
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-slate-700">Log in</button>
            </form>
        </div>
    </main>
{% endblock %}
