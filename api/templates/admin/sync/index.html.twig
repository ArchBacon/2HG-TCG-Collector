{% extends 'admin/base.html.twig' %}

{% block title %}Sync · TCG Admin{% endblock %}

{% block content %}
    <div class="mb-5">
        <h1 class="text-2xl font-semibold tracking-tight">Sync</h1>
        <p class="mt-1 text-sm text-slate-500">Run the sync commands from here, now or once at a set time, and follow their output like in a console. One job runs at a time; the next ones wait in the queue.</p>
    </div>

    {% if running %}
        <a href="{{ path('admin_sync_show', { id: running.id }) }}"
           class="mb-4 flex items-center gap-3 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 transition hover:bg-sky-100">
            {{ ux_icon('lucide:loader-circle', { class: 'h-4 w-4 shrink-0 animate-spin' }) }}
            <span class="min-w-0 flex-1"><span class="font-medium">{{ running.label }}</span> is running.</span>
            <span class="inline-flex shrink-0 items-center gap-1 font-medium">Follow {{ ux_icon('lucide:arrow-right', { class: 'h-4 w-4' }) }}</span>
        </a>
    {% endif %}

    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <form method="post" action="{{ path('admin_sync_start') }}" class="grid gap-4 sm:grid-cols-3 sm:items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('admin-sync') }}">

            <label class="flex flex-col gap-1.5 text-sm" id="sync-game">
                <span class="font-medium text-slate-700">Game</span>
                <select name="game" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                    {% for game in games %}
                        <option value="{{ game.value }}">{{ game.value }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="flex flex-col gap-1.5 text-sm">
                <span class="font-medium text-slate-700">Command</span>
                <select name="action" id="sync-action" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                    <option value="sync">Sync sets and cards (api:sync)</option>
                    <option value="images">Process queued images (api:process-images)</option>
                    <option value="cleanup">Clean up, every game (api:cleanup)</option>
                </select>
            </label>

            <label class="flex flex-col gap-1.5 text-sm" id="sync-images">
                <span class="font-medium text-slate-700">Images</span>
                <select name="images" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                    {% for value, label in imageModes %}
                        <option value="{{ value }}">{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="flex flex-col gap-1.5 text-sm">
                <span class="font-medium text-slate-700">When</span>
                <select name="when" id="sync-when" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                    <option value="now">Immediately</option>
                    <option value="scheduled">Scheduled</option>
                </select>
            </label>

            {# Once, at this date and time; there's deliberately no repeat. #}
            <div class="grid grid-cols-2 gap-3" id="sync-schedule">
                <label class="flex flex-col gap-1.5 text-sm">
                    <span class="font-medium text-slate-700">Date</span>
                    <input type="date" name="date" value="{{ defaultRunAt|date('Y-m-d') }}" min="{{ 'now'|date('Y-m-d') }}"
                           class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                </label>
                <label class="flex flex-col gap-1.5 text-sm">
                    <span class="font-medium text-slate-700">Time <span class="font-normal text-slate-400">({{ timezone }})</span></span>
                    <input type="time" name="time" value="{{ defaultRunAt|date('H:i') }}"
                           class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900">
                </label>
            </div>

            <button type="submit"
                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-slate-700 sm:col-start-3">
                <span class="inline-flex items-center gap-1.5" data-when="now">
                    {{ ux_icon(running ? 'lucide:list-plus' : 'lucide:play', { class: 'h-4 w-4' }) }}
                    {{ running ? 'Add to queue' : 'Start' }}
                </span>
                <span class="inline-flex items-center gap-1.5" data-when="scheduled" hidden>
                    {{ ux_icon('lucide:calendar-clock', { class: 'h-4 w-4' }) }}
                    Schedule
                </span>
            </button>
        </form>
    </section>

    {% if queue is not empty %}
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Queue</h2>
        <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <ol class="divide-y divide-slate-100">
                {% for job in queue %}
                    <li class="flex items-center gap-3 px-4 py-3 sm:px-5">
                        <span class="w-5 shrink-0 text-center text-sm font-medium text-slate-400">{{ loop.index }}</span>
                        <a href="{{ path('admin_sync_show', { id: job.id }) }}" class="min-w-0 flex-1 truncate text-sm font-medium text-slate-900 hover:underline">{{ job.label }}</a>
                        {% if job.runAt ?? null %}
                            <span class="inline-flex shrink-0 items-center gap-1 text-xs text-slate-500" title="Scheduled">
                                {{ ux_icon('lucide:calendar-clock', { class: 'h-3.5 w-3.5' }) }}
                                {{ job.runAt|date('j M H:i') }}
                            </span>
                        {% endif %}
                        <form method="post" action="{{ path('admin_sync_cancel', { id: job.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin-sync-cancel-' ~ job.id) }}">
                            <button type="submit" title="Remove from the queue"
                                    class="inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm text-slate-500 transition hover:bg-red-50 hover:text-red-700">
                                {{ ux_icon('lucide:x', { class: 'h-4 w-4' }) }}
                                <span class="hidden sm:inline">Remove</span>
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% endif %}

    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Cron</h2>
    <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <p class="px-4 pt-4 text-sm text-slate-500 sm:px-5">For the server's crontab, run from <span class="font-mono">{{ projectDir }}</span>. Run them now from here too.</p>
        <ul class="divide-y divide-slate-100">
            {% for cron in cronJobs %}
                <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-4 sm:px-5">
                    <div class="min-w-0 flex-1">
                        <p class="break-all font-mono text-sm text-slate-900">{{ cron.schedule }} php bin/console {{ cron.command }}</p>
                        <p class="mt-0.5 text-xs text-slate-500">{{ cron.does }}</p>
                    </div>
                    {% if cron.action %}
                        <form method="post" action="{{ path('admin_sync_start') }}" class="shrink-0">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin-sync') }}">
                            <input type="hidden" name="action" value="{{ cron.action }}">
                            <input type="hidden" name="when" value="now">
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                                {{ ux_icon(running ? 'lucide:list-plus' : 'lucide:play', { class: 'h-4 w-4' }) }}
                                {{ running ? 'Add to queue' : 'Run now' }}
                            </button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>

    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Recent jobs</h2>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        {% if jobs is empty %}
            <p class="px-4 py-10 text-center text-sm text-slate-500">Nothing has run from here yet.</p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for job in jobs %}
                    <li>
                        <a href="{{ path('admin_sync_show', { id: job.id }) }}" class="flex items-center gap-3 px-4 py-3 transition hover:bg-slate-50 sm:px-5">
                            {{ include('admin/sync/_status.html.twig', { job: job, running: job.running }) }}
                            <span class="min-w-0 flex-1 truncate text-sm font-medium text-slate-900">{{ job.label }}</span>
                            <span class="shrink-0 text-xs text-slate-500">{{ job.startedAt ? job.startedAt|date('j M H:i') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <script>
        (() => {
            // The image options only apply to api:sync, and the cleanup is for every game
            const action = document.getElementById('sync-action');
            const images = document.getElementById('sync-images');
            const game = document.getElementById('sync-game');
            const updateAction = () => {
                images.hidden = action.value !== 'sync';
                game.hidden = action.value === 'cleanup';
            };
            action.addEventListener('change', updateAction);
            updateAction();

            // The date and time only apply when scheduled; the button says what will happen
            const when = document.getElementById('sync-when');
            const schedule = document.getElementById('sync-schedule');
            const updateWhen = () => {
                const scheduled = when.value === 'scheduled';
                schedule.hidden = !scheduled;
                for (const input of schedule.querySelectorAll('input')) input.required = scheduled;
                for (const label of document.querySelectorAll('[data-when]')) label.hidden = label.dataset.when !== when.value;
            };
            when.addEventListener('change', updateWhen);
            updateWhen();
        })();
    </script>
{% endblock %}
