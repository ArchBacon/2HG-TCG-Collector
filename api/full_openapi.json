rmat":"uuid"},"code":{"description":"apitcg\u0027s own id for this print, e.g. \u0022FB01-001\u0022 or \u0022FB01-001-p1\u0022 for a parallel art\nvariant — unlike optcgapi\/lorcana-api, apitcg already suffixes every distinct print with\nits own globally unique id, so no separate base-card-id\/print-id split is needed here.","type":"string"},"set":{"type":"string","format":"iri-reference","example":"https:\/\/example.com\/"},"name":{"type":"string"},"cardType":{"description":"\u0022LEADER\u0022, \u0022BATTLE\u0022, \u0022EXTRA\u0022, or \u0022ENERGY MARKER\u0022.","type":"string"},"color":{"description":"\u0022Red\u0022, \u0022Blue\u0022, \u0022Green\u0022, \u0022Yellow\u0022, \u0022Black\u0022, or \u0022ALL\u0022 (Energy Marker and some Extra cards\nhave no color of their own). apitcg reports \u0022-\u0022 rather than omitting the field for cards\nthis doesn\u0027t apply to; the import pipeline normalizes that placeholder to null.","type":["string","null"]},"cost":{"description":"Energy cost to play. Null for Leaders and other cards apitcg reports as \u0022-\u0022.","type":["integer","null"]},"specifiedCost":{"description":"The specific energy colors required to pay {@see self::$cost}, e.g. \u0022R\u0022, \u0022RR\u0022, \u0022GGG\u0022\n(letters = color initials, repeated per pip). Null where apitcg reports \u0022-\u0022.","type":["string","null"]},"power":{"description":"Battle power. Null for cards apitcg reports as \u0022-\u0022 (e.g. most Extra cards).","type":["integer","null"]},"comboPower":{"description":"Power granted while used as a combo card. Null where apitcg reports \u0022-\u0022.","type":["integer","null"]},"features":{"description":"Card traits\/species, slash-separated, e.g. \u0022Saiyan\/Universe 7\u0022. Null where apitcg reports \u0022-\u0022.","type":["string","null"]},"effect":{"description":"Rules text. Contains literal \u0022\u003Cbr\u003E\u0022 line breaks, as reported by apitcg.","type":"string"},"getIt":{"description":"How the card is obtained, e.g. \u0022BOOSTER PACK -AWAKENED PULSE- [FB01]\u0022.","type":"string"},"rarity":{"description":"Null for cards apitcg reports with an empty rarity string (e.g. Energy Marker), not just\nunset — the import pipeline must normalize \u0022\u0022 to null before denormalizing since Rarity\nhas no case for it.","type":["string","null"],"enum":["L","C","UC","R","SR","SCR","PR",null]},"images":{"readOnly":true,"description":"Our own served copies of this card\u0027s image (mirroring\n{@see \\App\\Games\\Pokemon\\Entity\\Card::$images} \/ {@see \\App\\Games\\MTG\\Entity\\Card::$images}),\nnot apitcg\u0027s URL.","type":"object","additionalProperties":{"type":"string"}}}}]},"CardCount.jsonld-set.read":{"type":"object"},"CardDetails.jsonld-card.v2.read":{"type":"object","properties":{"mana_cost":{"type":["string","null"]}}},"CardV2.jsonld-card.v2.read":{"allOf":[{"$ref":"#\/components\/schemas\/HydraItemBaseSchema"},{"type":"object","properties":{"details":{"$ref":"#\/components\/schemas\/CardDetails.jsonld-card.v2.read"},"id":{"type":"string"},"name":{"type":"string"},"tcg":{"type":"string"},"lang":{"type":"string"},"number":{"type":"string"},"rarity":{"type":["string","null"]},"artist":{"type":["string","null"]},"type_line":{"type":"string"},"images":{"type":["object","null"],"additionalProperties":{"type":"string"}},"faces":{"type":"array","items":{"type":"string"}},"oracle_text":{"type":["string","null"]},"flavor_text":{"type":["string","null"]},"set":{"$ref":"#\/components\/schemas\/ApiResource.Set.jsonld-card.v2.read"},"variants":{"type":"array","items":{"type":"string"}},"related":{"type":"array","items":{"type":"string"}}}}],"description":"v2 MTG card resource: extends the shared {@see \\App\\ApiResource\\Card} envelope with MTG\u0027s own\n{@see CardDetails}. Served from {@see \\App\\Games\\MTG\\Entity\\Card} via\n{@see CardProvider}\/{@see CardMapper}. `shortName` is set explicitly so this doesn\u0027t collide\nwith the v1 {@see \\App\\Games\\MTG\\Entity\\Car